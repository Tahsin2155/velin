{
  "manifest_version": 3,
  "name": "Velin — New Tab",
  "version": "2.1.0",
  "description": "A new-tab start page with widgets, notes, bookmarks and backgrounds. Everything is stored locally in your browser.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "app.html"
  },
  "permissions": [
    "unlimitedStorage"
  ]
}
